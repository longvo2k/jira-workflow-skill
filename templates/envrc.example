# Secrets for the jira-workflow skill, loaded by direnv.
# Never commit this file: add .envrc to .gitignore.
#
# Tip: put these in one parent folder's .envrc (e.g. ~/Work/.envrc) and add
# `source_up` to each project's .envrc, so every project shares the tokens.

# Jira: https://id.atlassian.com/manage-profile/security/api-tokens
# (Jira Server/Data Center: use a Personal Access Token and set "authType": "bearer")
export JIRA_LOGIN="you@company.com"
export JIRA_API_TOKEN=""

# Bitbucket Cloud API token (scopes: read:user, read:repository, read:pullrequest, read:pipeline)
# Create one at https://id.atlassian.com/manage-profile/security/api-tokens -> "Create API token with scopes" -> Bitbucket
export BITBUCKET_EMAIL="you@company.com"
export BITBUCKET_API_TOKEN=""
# Or a repository/workspace access token instead of the two lines above:
# export BITBUCKET_ACCESS_TOKEN=""

# Optional: keep tokens in the macOS Keychain instead of plain text
# export JIRA_API_TOKEN="$(security find-generic-password -s jira-api-token -w)"

# Optional: point to a workspace file somewhere else
# export JIRA_WORKSPACE_FILE="$PWD/.jira-workspace.json"
